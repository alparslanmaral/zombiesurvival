# Copy to .env.local for local overrides. All optional.

# Signaling strategy for Trystero: nostr (default) | torrent | mqtt
VITE_TRYSTERO_STRATEGY=nostr

# Optional TURN server for players behind strict NATs (comma-separated URLs allowed)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Asset base path. Default "./" works on any GitHub Pages URL because routing is hash-based.
VITE_BASE_PATH=
